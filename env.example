# Supabase Configuration
# Get these from your Supabase project dashboard: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key (Optional - for AI dialogue and word explanation features)
# Get this from Google Cloud Console: https://console.cloud.google.com
VITE_GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Instructions:
# 1. Copy this file to .env (do not commit .env to git)
# 2. Replace the placeholder values with your actual credentials
# 3. For Supabase credentials:
#    - Go to https://app.supabase.com
#    - Select your project
#    - Go to Settings → API
#    - Copy the Project URL and anon/public key
# 4. For Gemini API key:
#    - Go to https://console.cloud.google.com
#    - Enable the Gemini API
#    - Create an API key
#    - Copy the key here

